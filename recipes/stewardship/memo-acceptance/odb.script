CREATE MEMORY TABLE KONTO(ID INTEGER PRIMARY KEY,NUMMER VARCHAR(8),NAMN VARCHAR(80));
CREATE MEMORY TABLE VER(ID INTEGER PRIMARY KEY,NUMMER INTEGER,DATUM DATE,TEXT VARCHAR(120));
CREATE MEMORY TABLE TRANS(ID INTEGER PRIMARY KEY,VER_ID INTEGER,KONTO_ID INTEGER,BELOPP DECIMAL(14,2),TEXT VARCHAR(120));
